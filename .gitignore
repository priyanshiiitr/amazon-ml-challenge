# Datasets and intermediates are far too large for git.
# student_resource/ is the organisers' zip, unpacked; work/ is derived parquet.
student_resource/
__MACOSX/
work/
*.zip
*.parquet
*.pkl

# Submission outputs: matching_results.tsv is ~88 MB and candidate_pairs.tsv is
# ~1.5 GB, both over GitHub's limits. They are regenerated by the pipeline
# (see README) and delivered in the final submission zip instead.
output/*.tsv

# Never commit credentials.
*.pem
*.csv
.aws/

__pycache__/
*.pyc
.venv/
